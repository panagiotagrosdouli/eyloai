{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --no-audit --no-fund",
  "rewrites": [
    {
      "source": "/api/developer",
      "destination": "/api/system?endpoint=developer"
    },
    {
      "source": "/api/admin-operations",
      "destination": "/api/system?endpoint=admin-operations"
    },
    {
      "source": "/api/capabilities",
      "destination": "/api/system?endpoint=capabilities"
    },
    {
      "source": "/api/contact",
      "destination": "/api/system?endpoint=contact"
    },
    {
      "source": "/api/deployment-status",
      "destination": "/api/system?endpoint=deployment-status"
    },
    {
      "source": "/supabase/:path*",
      "destination": "https://kbzjngpzxpniaumlupaa.supabase.co/:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/monitor",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/discovery.js": {
      "maxDuration": 20
    }
  }
}
