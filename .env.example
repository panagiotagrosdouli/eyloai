# Public browser configuration
# Copy to .env.local for local development. Never commit real values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional server-side scholarly provider credentials; never prefix these with VITE_.
# OpenAlex: authenticated API budget. Semantic Scholar: authenticated request quota.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_CONTACT_EMAIL=

# Server-side AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Server-side Supabase access
# Optional runtime URL; if set, it must match VITE_SUPABASE_URL.
SUPABASE_URL=
# Prefer the current Supabase publishable/secret keys. Legacy fallbacks remain supported.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe Billing — staging TEST mode only; these are not production release approvals.
# Actual checkout is disabled unless all staging identity checks, the explicit
# opt-in, and sk_test_ credentials pass. Do not enable on the live EYLO project.
EYLO_ENVIRONMENT=development
EYLO_BILLING_TEST_ENABLED=0
EYLO_STAGING_SUPABASE_REF=
EYLO_STAGING_CONFIRMED_REF=
# Staging billing also requires APP_URL to be the reviewed HTTPS preview origin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_FOUNDER_PRICE_ID=

# Hosted application and scheduled jobs
APP_URL=http://localhost:5173
CRON_SECRET=

# Careers email delivery (Resend - verified sending domain required)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=
# Keep the public form disabled until a verified sender, accepted provider request and inbox delivery
# have been tested on the intended hosted environment. Set to 1 only after owner sign-off.
CONTACT_PUBLIC_ENABLED=0

# Native EYLO meetings: server-issued short-lived access tokens + LiveKit SFU.
# LIVEKIT_URL is the public wss:// endpoint that browsers can reach. Keep both
# credentials server-only; never prefix them with VITE_.
LIVEKIT_URL=wss://your-livekit-host.example
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Isolated free-account staging deletion candidate. Never enable in production.
# Requires independently verified staging identity and reviewed lifecycle migration.
# Stripe-configured environments remain disabled; no automatic worker is scheduled.
EYLO_PRIVACY_DELETION_ENABLED=false
EYLO_PRIVACY_WORKER_SECRET=
