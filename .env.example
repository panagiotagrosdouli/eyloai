# Public browser configuration
# Copy to .env.local for local development. Never commit real values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional server-side scholarly provider credentials; never prefix these with VITE_.
# OpenAlex: authenticated API budget. Semantic Scholar: authenticated request quota.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_CONTACT_EMAIL=

# Server-side AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Server-side Supabase access
# Prefer the current Supabase publishable/secret keys. Legacy fallbacks remain supported.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_FOUNDER_PRICE_ID=

# Hosted application and scheduled jobs
APP_URL=http://localhost:5173
CRON_SECRET=

# Careers email delivery (Resend - verified sending domain required)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=
